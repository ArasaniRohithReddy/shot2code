{
  "name": "shot2code-desktop",
  "private": true,
  "version": "0.4.0",
  "description": "Turn screenshots, mockups and screen recordings into clean code using AI",
  "author": "Arasani Rohith Reddy",
  "license": "MIT",
  "homepage": "https://github.com/ArasaniRohithReddy/shot2code",
  "repository": {
    "type": "git",
    "url": "https://github.com/ArasaniRohithReddy/shot2code.git",
    "directory": "desktop"
  },
  "bugs": {
    "url": "https://github.com/ArasaniRohithReddy/shot2code/issues"
  },
  "keywords": [
    "screenshot-to-code",
    "electron",
    "ai",
    "code-generation",
    "github-copilot",
    "desktop-app"
  ],
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test update-lifecycle.test.js installer-preinstall.test.js backend-readiness.test.js zoom-controls.test.js app-menu.test.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis msi zip --publish never",
    "release": "electron-builder --win nsis msi zip --publish always"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  }
}
