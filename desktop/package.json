{
  "name": "shot2code-desktop",
  "private": true,
  "version": "0.5.2",
  "workspaces": [],
  "description": "Turn screenshots, mockups and screen recordings into clean code using AI",
  "author": "Arasani Rohith Reddy",
  "license": "MIT",
  "homepage": "https://github.com/ArasaniRohithReddy/shot2code",
  "repository": {
    "type": "git",
    "url": "https://github.com/ArasaniRohithReddy/shot2code.git",
    "directory": "desktop"
  },
  "bugs": {
    "url": "https://github.com/ArasaniRohithReddy/shot2code/issues"
  },
  "keywords": [
    "screenshot-to-code",
    "electron",
    "ai",
    "code-generation",
    "github-copilot",
    "desktop-app"
  ],
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test update-lifecycle.test.js installer-preinstall.test.js backend-readiness.test.js backend-auth-restart.test.js zoom-controls.test.js window-state.test.js app-menu.test.js stitch-sdk.test.js github-oauth.test.js feedback.test.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis msi zip --publish never",
    "release": "electron-builder --win nsis msi zip --publish always"
  },
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@google/stitch-sdk": "^0.3.5",
    "electron-updater": "^6.8.9"
  }
}
